+size_t AtomicBinaryToBase64(const char* input, size_t length, char* output,
+                            simdutf::base64_options options) {
+#if SIMDUTF_ATOMIC_REF
+  return simdutf::atomic_binary_to_base64(input, length, output, options);
+#else
+  // Android's NDK libc++ does not currently provide std::atomic_ref. Preserve
+  // SharedArrayBuffer byte-level atomicity while encoding in 3-byte-aligned
+  // chunks so each chunk can be encoded independently.
+  constexpr size_t kInputBlockSize = 1024 * 3;
+  std::array<char, kInputBlockSize> input_buffer;
+  const auto* atomic_input =
+      reinterpret_cast<const volatile base::Atomic8*>(input);
+  size_t output_offset = 0;
+
+  for (size_t input_offset = 0; input_offset < length;
+       input_offset += kInputBlockSize) {
+    const size_t current_block_size =
+        std::min(kInputBlockSize, length - input_offset);
+    for (size_t i = 0; i < current_block_size; ++i) {
+      input_buffer[i] = base::Relaxed_Load(atomic_input + input_offset + i);
+    }
+    output_offset += simdutf::binary_to_base64(
+        input_buffer.data(), current_block_size, output + output_offset,
+        options);
+  }
+  return output_offset;
+#endif
+}
